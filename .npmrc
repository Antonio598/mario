# Metro (el bundler de Expo) no resuelve enlaces simbolicos anidados de forma fiable.
# Con node-linker=hoisted pnpm genera un node_modules plano compatible con React Native
# sin renunciar al almacen global de paquetes.
node-linker=hoisted

# El ecosistema de React Native declara peers de forma inconsistente. Sin esto,
# la instalacion falla por conflictos que en la practica no rompen nada.
strict-peer-dependencies=false

# Los paquetes internos del monorepo se enlazan siempre a la version del workspace.
link-workspace-packages=true
prefer-workspace-packages=true
