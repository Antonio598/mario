# =============================================================================
# Reset Alfa — plantilla de variables de entorno
#
# Copia este fichero a .env para desarrollo local. NUNCA pongas valores reales
# aqui: este fichero SI entra en el repositorio.
#
# En produccion, todas estas variables se definen en el panel de EasyPanel
# (Service > Environment), nunca en el codigo.
# =============================================================================


# -----------------------------------------------------------------------------
# PUBLICAS — se incrustan en el bundle del navegador y de la app.
#
# AVISO: cualquier persona puede leerlas en el codigo cliente. Eso es correcto
# y esperado: la anon key solo tiene los permisos que le concede la RLS.
#
# AVISO CRITICO DE BUILD: Next.js incrusta las NEXT_PUBLIC_* en tiempo de
# COMPILACION, no de ejecucion. En EasyPanel hay que declararlas ademas como
# Build Arguments del Dockerfile. Si solo se declaran como variables de entorno
# del contenedor, el build sale sin claves y la web arranca rota.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
NEXT_PUBLIC_SITE_URL=https://modoguerrero.es

# Version de la politica de privacidad vigente. Se guarda en cada fila de
# `consents`, de modo que sabemos que texto acepto exactamente cada usuario.
NEXT_PUBLIC_PRIVACY_POLICY_VERSION=2026-07-30

# Analitica y publicidad (Fase 3). Vacio = desactivado.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=


# -----------------------------------------------------------------------------
# SECRETAS — solo servidor. Jamas deben aparecer en codigo cliente.
#
# La service_role key salta TODA la RLS. Filtrarla equivale a entregar la base
# de datos entera, incluidos los datos de categoria especial del art. 9 RGPD.
# Se importa unicamente desde apps/web/src/lib/supabase/admin.ts, que lleva
# la directiva `import 'server-only'` para que un import desde cliente rompa
# el build en lugar de filtrarla en silencio.
# -----------------------------------------------------------------------------

SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# Sal del servidor para hashear IPs antes de guardarlas en `consents`.
# Nunca almacenamos IPs en claro. Genera una con: openssl rand -hex 32
CONSENT_IP_SALT=

# Secreto compartido con n8n para revalidar rutas ISR tras publicar un articulo
# (Fase 3). Genera uno con: openssl rand -hex 32
REVALIDATE_SECRET=


# -----------------------------------------------------------------------------
# APP MOVIL (Expo) — se leen via app.config.ts > extra
#
# Expo tambien incrusta estas en el bundle. Solo valores publicos.
# -----------------------------------------------------------------------------

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
EXPO_PUBLIC_SITE_URL=https://modoguerrero.es


# -----------------------------------------------------------------------------
# FASE 4 — Stripe. No se usa todavia.
# -----------------------------------------------------------------------------

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=


# -----------------------------------------------------------------------------
# FASE 3 — n8n y Telegram. No se usa todavia.
# -----------------------------------------------------------------------------

ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
