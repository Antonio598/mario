# =============================================================================
# Reset Alfa — plantilla de variables de entorno
#
# Copia este fichero a .env para desarrollo local. NUNCA pongas valores reales
# aqui: este fichero SI entra en el repositorio.
#
# En produccion, todas estas variables se definen en el panel de EasyPanel
# (Service > Environment), nunca en el codigo.
# =============================================================================


# -----------------------------------------------------------------------------
# PUBLICAS — se incrustan en el bundle del navegador y de la app.
#
# AVISO: cualquier persona puede leerlas en el codigo cliente. Eso es correcto
# y esperado: la anon key solo tiene los permisos que le concede la RLS.
#
# AVISO CRITICO DE BUILD: Next.js incrusta las NEXT_PUBLIC_* en tiempo de
# COMPILACION, no de ejecucion. En EasyPanel hay que declararlas ademas como
# Build Arguments del Dockerfile. Si solo se declaran como variables de entorno
# del contenedor, el build sale sin claves y la web arranca rota.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
NEXT_PUBLIC_SITE_URL=https://app.modoguerrero.es

# Esquema Postgres donde vive Reset Alfa.
#   public      Proyecto Supabase dedicado (migraciones de supabase/migrations)
#   reset_alfa  Proyecto compartido con otra app
#               (supabase/instalacion-esquema-aislado.sql)
#
# En Supabase SELF-HOSTED no basta con esto: hay que anadir el esquema a
# PGRST_DB_SCHEMAS del servicio `rest` en el docker-compose y reiniciarlo, o
# PostgREST no lo expondra y la API devolvera 404 en todas las tablas.
NEXT_PUBLIC_SUPABASE_SCHEMA=public

# Version de la politica de privacidad vigente. Se guarda en cada fila de
# `consents`, de modo que sabemos que texto acepto exactamente cada usuario.
NEXT_PUBLIC_PRIVACY_POLICY_VERSION=2026-07-30

# Analitica y publicidad (Fase 3). Vacio = desactivado.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=


# -----------------------------------------------------------------------------
# SECRETAS — solo servidor. Jamas deben aparecer en codigo cliente.
#
# La service_role key salta TODA la RLS. Filtrarla equivale a entregar la base
# de datos entera, incluidos los datos de categoria especial del art. 9 RGPD.
# Se importa unicamente desde apps/web/src/lib/supabase/admin.ts, que lleva
# la directiva `import 'server-only'` para que un import desde cliente rompa
# el build en lugar de filtrarla en silencio.
# -----------------------------------------------------------------------------

SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# Sal del servidor para hashear IPs antes de guardarlas en `consents`.
# Nunca almacenamos IPs en claro. Genera una con: openssl rand -hex 32
CONSENT_IP_SALT=

# Secreto compartido con n8n para revalidar rutas ISR tras publicar un articulo
# (Fase 3). Genera uno con: openssl rand -hex 32
REVALIDATE_SECRET=


# -----------------------------------------------------------------------------
# CORREO (Resend) — SOLO SERVIDOR
#
# Aviso al equipo cada vez que alguien completa el protocolo post-recaida.
# NUNCA como NEXT_PUBLIC_ y NUNCA como Build Argument: una clave de Resend en
# el navegador permite enviar correo desde el dominio de la marca a cualquiera
# que abra las herramientas de desarrollo.
#
# Sin RESEND_API_KEY el aviso simplemente no se envia. La recaida se guarda
# igual: el correo es un aviso, no el registro.
#
# RESEND_FROM tiene que usar un dominio verificado en Resend, o la API lo
# rechaza. Para probar sin dominio propio: onboarding@resend.dev, que solo
# puede enviar al correo de la cuenta de Resend.
# -----------------------------------------------------------------------------

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Reset Alfa <recaidas@modoguerrero.es>
# Destinatario del aviso. OBLIGATORIO: sin esto no se envia nada. No se pone
# por defecto en el codigo a proposito, porque el repositorio es publico.
RESEND_TO=


# -----------------------------------------------------------------------------
# APP MOVIL (Expo) — se leen via app.config.ts > extra
#
# Expo tambien incrusta estas en el bundle. Solo valores publicos.
# -----------------------------------------------------------------------------

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
EXPO_PUBLIC_SITE_URL=https://app.modoguerrero.es
EXPO_PUBLIC_SUPABASE_SCHEMA=public

# Compra de Premium dentro de la app (App Store / Google Play via RevenueCat).
# Claves PUBLICAS del proyecto de RevenueCat, una por tienda. Sin la de una
# plataforma, en esa plataforma no se puede comprar y Premium se describe como
# "gestionado desde la web". Paso a paso: docs/compras-en-la-app.md
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Identificador del entitlement en el panel de RevenueCat. Por defecto "premium".
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=premium


# -----------------------------------------------------------------------------
# STRIPE — suscripcion Premium (10 USD/mes). SOLO SERVIDOR.
#
# En el panel de Stripe:
#   1. Producto "Reset Alfa Premium" con un precio RECURRENTE mensual de 10 USD.
#      Su id (price_...) va en STRIPE_PREMIUM_PRICE_ID. Es distinto en modo
#      prueba y en modo real: por eso no esta en el seed SQL.
#   2. Webhook apuntando a https://<dominio>/api/stripe/webhook con los
#      eventos: checkout.session.completed, invoice.paid,
#      invoice.payment_failed, customer.subscription.updated,
#      customer.subscription.deleted. Su secreto (whsec_...) va en
#      STRIPE_WEBHOOK_SECRET.
#   3. Customer Portal activado (Settings > Billing > Customer portal): es
#      donde el usuario cancela y cambia la tarjeta.
#
# En EasyPanel van en Environment, nunca en Build Arguments.
# -----------------------------------------------------------------------------

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# Calculo automatico del IVA. Dejalo vacio hasta tener Stripe Tax configurado
# en el panel: si se pide sin configurarlo, Stripe rechaza el pago entero.
STRIPE_AUTOMATIC_TAX=


# -----------------------------------------------------------------------------
# REVENUECAT — la misma suscripcion Premium comprada DENTRO de la app. SOLO
# SERVIDOR (Environment de EasyPanel).
#
# El servidor recibe el webhook de RevenueCat y copia el estado del
# suscriptor a `entitlements` con origen apple/google. Requiere haber pegado
# supabase/tiendas-origen.sql.
# -----------------------------------------------------------------------------

# Clave SECRETA (v1) del proyecto: RevenueCat > Project settings > API keys.
REVENUECAT_SECRET_KEY=
# Valor de la cabecera Authorization que se configura en el webhook de
# RevenueCat. Inventalo largo (p. ej. `openssl rand -hex 32`).
REVENUECAT_WEBHOOK_SECRET=
# Identificador del entitlement. Por defecto "premium".
REVENUECAT_ENTITLEMENT_ID=premium


# -----------------------------------------------------------------------------
# ELIMINACION DE CUENTA (Apple 5.1.1(v) y Google Play)
#
# Las tiendas exigen que el usuario pueda borrar su cuenta desde la app. Por
# defecto se borra TODO: los datos de Reset Alfa y la identidad (auth.users),
# y se cancela la suscripcion de Stripe si la hay. Requiere
# SUPABASE_SERVICE_ROLE_KEY.
#
# La base esta compartida con el CRM: borrar la identidad la borra tambien
# alli. Solo si hiciera falta conservarla:
#
#   false  Solo los datos de Reset Alfa. La cuenta sobrevive en el CRM.
#          NO cumple el requisito de las tiendas.
# -----------------------------------------------------------------------------

BORRAR_IDENTIDAD_AL_ELIMINAR=


# -----------------------------------------------------------------------------
# FASE 3 — n8n y Telegram. No se usa todavia.
# -----------------------------------------------------------------------------

ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
