{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "React Native / Expo",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["react", "react-native"]
  }
}
